# ---- 构建产物 ----
build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
*.iml
.idea/
*.apk
*.aab

# ---- 本机配置 ----
# sdk.dir 与具体机器绑定
local.properties

# ---- 发布归档 ----
# dist/ 里是 APK、源码快照与 RELEASE.md（约 1 GB，30+ 历史版本）。
# 二进制一律走 Release 分发，不入库，否则克隆成本会高到不可用。
dist/

# ---- 真实数据样本（含个人信息）----
# docs/samples/reference/ 是从教务系统导出的真实课表（含课程、教师，可能含姓名与学号），
# 保留在本地用于校准解析器，禁止入库或公开。
# 内置的虚构样例位于 app/src/main/assets/samples/，该部分可以入库。
docs/samples/reference/

# ---- 其他 ----
.DS_Store
Thumbs.db
*.log
*.hprof

# 签名密钥不入库。固定密钥放在仓库之外的 keystore/ 目录，
# CI 通过 GitHub Secrets 传入
*.jks
*.keystore
