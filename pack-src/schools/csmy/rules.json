{
  "schema": 1,
  "id": "csmy",
  "name": "长沙民政职业技术学院",
  "version": "2026.11.15",
  "source": "长沙民政职业技术学院公开页面",
  "signature": [
    "星期",
    "节",
    "周"
  ],
  "patterns": {
    "weekRange": "(\\d{1,2})\\s*[-~—－至]\\s*(\\d{1,2})\\s*周",
    "weekList": "((?:\\d{1,2}\\s*[,，、]\\s*)+\\d{1,2})\\s*周",
    "weekSingle": "(\\d{1,2})\\s*周",
    "weekOdd": "\\(\\s*单\\s*\\)|（\\s*单\\s*）|单周",
    "weekEven": "\\(\\s*双\\s*\\)|（\\s*双\\s*）|双周",
    "sectionRange": "第?\\s*(\\d{1,2})\\s*[-~—－至]\\s*(\\d{1,2})\\s*节",
    "sectionSingle": "第?\\s*(\\d{1,2})\\s*节",
    "dayPattern": "(?:星期|周)\\s*([一二三四五六日天])",
    "teacherLabelled": "(?:教师|老师|任课教师)\\s*[:：]?\\s*([\\u4e00-\\u9fa5]{2,4})",
    "teacherSuffix": "([\\u4e00-\\u9fa5]{2,4})\\s*老师",
    "room": "(?:场地|教室|地点)\\s*[:：]\\s*([^\\s,，;；]{2,20})"
  },
  "tokens": {
    "dayPrefixes": [
      "星期",
      "周"
    ],
    "dayWords": {
      "一": 1,
      "二": 2,
      "三": 3,
      "四": 4,
      "五": 5,
      "六": 6,
      "日": 7,
      "天": 7
    },
    "weekUnit": "周",
    "sectionUnit": "节",
    "teacherLabels": [
      "教师",
      "老师",
      "任课教师"
    ],
    "roomLabels": [
      "场地",
      "教室",
      "地点"
    ]
  },
  "limits": {
    "maxWeeks": 20,
    "maxSections": 14
  },
  "news": "schools/csmy/news.json",
  "importer": {
    "formats": [
      "pdf",
      "xlsx",
      "docx",
      "txt",
      "html"
    ],
    "pdf": {
      "columnAnchor": "星期",
      "rowGapPt": 13.0,
      "headerPerPage": true,
      "cellRegex": "^(?<name>.*?)\\((?<s1>\\d+)-(?<s2>\\d+)节\\)(?<weeks>[^/]+)(?:.*?场地[:：](?<room>[^/]*))?(?:.*?教师[:：](?<teacher>[^/]*))?(?:.*?课程性质简称[:：](?<category>[^/]*))?",
      "noiseDrop": [
        "时间段",
        "节次"
      ]
    }
  },
  "capabilities": {
    "attendance": false,
    "login": false,
    "widget": true
  },
  "notes": "课表 PDF 按一条 cellRegex 解析（节次/周次/场地/课程性质），教师姓名因字体子集缺映射可能为空；校历待补，周次需手动设置。",
  "domains": [
    "csmzxy.edu.cn"
  ],
  "weekSyntax": {
    "separators": ",，、",
    "range": "第?(\\d{1,2})\\s*[-~—－至]\\s*(\\d{1,2})\\s*周",
    "single": "第?(\\d{1,2})\\s*周",
    "odd": "(?:[(（]\\s*单\\s*[)）]|单周)",
    "even": "(?:[(（]\\s*双\\s*[)）]|双周)"
  },
  "calendar": "schools/csmy/calendar.json",
  "portal": "schools/csmy/portal.json",
  "publicCourse": {
    "preset": "C",
    "badge": "公选课",
    "matchKeywords": [
      "公必",
      "公限",
      "公选"
    ]
  }
}
