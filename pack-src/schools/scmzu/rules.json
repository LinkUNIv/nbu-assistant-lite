{
  "schema": 1,
  "id": "scmzu",
  "name": "中南民族大学",
  "version": "2026.11.20",
  "source": "pack",
  "patterns": {
    "weekRange": "(\\d{1,2})\\s*[-~—－至]\\s*(\\d{1,2})\\s*周",
    "weekList": "((?:\\d{1,2}\\s*[,，、]\\s*)+\\d{1,2})\\s*周",
    "weekSingle": "(\\d{1,2})\\s*周",
    "weekOdd": "\\(\\s*单\\s*\\)|（\\s*单\\s*）|单周",
    "weekEven": "\\(\\s*双\\s*\\)|（\\s*双\\s*）|双周",
    "sectionRange": "第?\\s*(\\d{1,2})\\s*[-~—－至]\\s*(\\d{1,2})\\s*节",
    "sectionSingle": "第?\\s*(\\d{1,2})\\s*节",
    "dayPattern": "(?:星期|周)\\s*([一二三四五六日天])",
    "teacherLabelled": "(?:教师|老师|任课教师)\\s*[:：]?\\s*([\\u4e00-\\u9fa5]{2,4})",
    "teacherSuffix": "([\\u4e00-\\u9fa5]{2,4})\\s*老师",
    "room": "(?:场地|教室|地点)\\s*[:：]\\s*([^\\s,，;；]{2,20})"
  },
  "tokens": {
    "dayPrefixes": [
      "星期",
      "周"
    ],
    "dayWords": {
      "一": 1,
      "二": 2,
      "三": 3,
      "四": 4,
      "五": 5,
      "六": 6,
      "日": 7,
      "天": 7
    },
    "weekUnit": "周",
    "sectionUnit": "节",
    "teacherLabels": [
      "教师",
      "老师",
      "任课教师"
    ],
    "roomLabels": [
      "场地",
      "教室",
      "地点"
    ]
  },
  "limits": {
    "maxWeeks": 20,
    "maxSections": 14
  },
  "news": "schools/csmy/news.json",
  "importer": {
    "formats": [
      "pdf"
    ],
    "pdf": {
      "columnAnchor": "星期",
      "rowGapPt": 20,
      "headerPerPage": false,
      "namePrefixMerge": true,
      "cellRegex": "^(?<name>[^\\[]+?)\\s*\\[(?<code>[^\\]]*)\\]\\s*(?<weeks>\\d[\\d,\\-]*\\s*周(?:\\s*[（(]\\s*[单双]\\s*[)）])?)\\s*[（(]\\s*第?\\s*(?<s1>\\d+)\\s*[-—~]\\s*(?<s2>\\d+)\\s*节\\s*[)）]\\s*(?<teacher>[^\\d]*)\\s*(?<room>.+)$",
      "noiseDrop": [
        "节次",
        "课程名称",
        "教学周次",
        "备注",
        "上课老师",
        "同学课表"
      ],
      "multiCourse": true,
      "columnEdge": "center",
      "groupByCourseCode": true
    }
  },
  "capabilities": {
    "attendance": false,
    "login": false,
    "widget": true
  },
  "notes": "课表来自教务系统「报表打印页面」导出的 PDF。文字逐 token 绘制，同一行要按 x 排序；同格可能排着单周与双周两门课，靠 multiCourse 切分。",
  "domains": [
    "scuec.edu.cn"
  ],
  "weekSyntax": {
    "separators": ",，、",
    "range": "第?(\\d{1,2})\\s*[-~—－至]\\s*(\\d{1,2})\\s*周",
    "single": "第?(\\d{1,2})\\s*周",
    "odd": "(?:[(（]\\s*单\\s*[)）]|单周)",
    "even": "(?:[(（]\\s*双\\s*[)）]|双周)"
  },
  "calendar": "schools/csmy/calendar.json",
  "portal": "schools/csmy/portal.json"
}
